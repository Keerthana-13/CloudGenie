# Copy to .env and fill in your own values. .env is git-ignored. NEVER commit a real key.

# --- Model provider (any OpenAI-compatible chat endpoint) ---------------------------
# gemini | openrouter | groq | none     ("none" = no LLM, extractive answers only)
LLM_PROVIDER=gemini
# One key variable per provider; set the one matching LLM_PROVIDER (or use LLM_API_KEY for any).
GEMINI_API_KEY=your_key_here
OPENROUTER_API_KEY=your_key_here
GROQ_API_KEY=your_key_here
# Optional overrides. Defaults per provider are set in src/config.py.
MODEL_NAME= gemini-3.5-flash-lite
# LLM_BASE_URL=
# Free tiers throttle: keep requests per minute below your quota.
LLM_RPM=10

# --- Retrieval ---------------------------------------------------------------------
# auto = MiniLM if installed (requirements-dense.txt), else offline TF-IDF
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=3

# --- Storage -----------------------------------------------------------------------
STORAGE_DIR=./storage
DATABASE_URL=sqlite:///./storage/decisions.db

# --- Routing (optional overrides; defaults live in config/policy.json, tuned on data) -
# CONFIDENCE_THRESHOLD=0.65
# RETRIEVAL_MIN_SCORE=0.10

# --- Operations --------------------------------------------------------------------
LOG_LEVEL=INFO
# Kill switch: set to false (or create storage/KILL_SWITCH) to escalate everything instantly.
AUTO_RESPOND_ENABLED=true
# Required header (X-Admin-Token) to use the /admin/kill-switch endpoint.
ADMIN_TOKEN=change_me
